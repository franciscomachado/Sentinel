# Sentinel Docker environment
# Copy to .env and fill in your values.

# ── AI Provider (required) ──────────────────────────────────────
# Default provider is Anthropic. Set the key for whichever provider you use.
ANTHROPIC_API_KEY=sk-ant-...

# Other providers — uncomment the one you need:
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...

# Optional: override the model (works with any provider)
# SENTINEL_MODEL=claude-sonnet-4-20250514

# ── CalDAV (Radicale) ───────────────────────────────────────────
SENTINEL_CALDAV_USER=sentinel
SENTINEL_CALDAV_PASS=changeme

# ── Email (IMAP) ────────────────────────────────────────────────
# One variable per account: SENTINEL_IMAP_PASS_<ACCOUNT_NAME>
# SENTINEL_IMAP_PASS_PERSONAL=your-email-password

# ── Shopping list (optional) ────────────────────────────────────
# BRING_EMAIL=you@example.com
# BRING_PASSWORD=your-bring-password
